{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GPTTrace",
  "version": "0.1.0",
  "identifier": "com.gpttrace.desktop",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "windows": [
      {
        "title": "GPTTrace",
        "width": 1100,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 420,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Private AI detector for text, images and audio",
    "copyright": "\u00a9 2026 GPTTrace"
  }
}
