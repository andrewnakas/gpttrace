{
  "manifest_version": 3,
  "name": "GPTTrace: Private AI Detector",
  "short_name": "GPTTrace",
  "version": "0.1.0",
  "description": "Right-click an image or selected text to check it for signs of AI. Runs on your device; nothing is uploaded.",
  "homepage_url": "https://gpttrace.com/",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "GPTTrace: check an image or text", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; base-uri 'none'; form-action 'none'" }
}
